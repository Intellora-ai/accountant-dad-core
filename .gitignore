# Virtual environments
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Test and tool caches
.pytest_cache/
.testmondata*
.gremlins_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artefacts
dist/
build/

# Reports uploaded as CI artefacts, never committed
reports/

# macOS
.DS_Store

# Mutation and coverage reports
coverage/

# Pinned tools fetched by scripts/install-actionlint
.tools/

# TLS material. A private key committed once is in every clone and every fork
# forever, and six months later nobody can tell a test key from a real one by
# looking at it. Tests generate their certificate into `tmp_path` at run time
# (`tests/test_tls.py::certificate`), which is outside this tree already; these
# three lines are the second line of defence for the day somebody makes one in
# the working directory to try something.
*.pem
*.key
*.crt

# The durable database. This is a REAL CUSTOMER'S AUDIT TRAIL and their vendor
# and account history - the one file in this project that must never reach a
# commit. `ACCOUNTANT_DB` moves it; `data/app.db` is where it lands otherwise.
data/
*.db
*.sqlite3

# Agent worktrees. Nested git repositories, never part of a commit.
.claude/worktrees/

# The Tally audit trail. Same reasoning as `data/` above, and the same danger:
# every request and response XML under here carries a REAL COMPANY NAME, real
# supplier names and real amounts. Measured 2026-08-12: 21 files, all naming the
# live company. This repository is PUBLIC.
#
# The log is evidence, and it is meant to live on the machine that produced it.
# `ACCOUNTANT_LOG_DIR` and `ACCOUNTANT_XML_LOG_DIR` move it elsewhere.
logs/

# Superseded scratch client, kept locally because it works and it was asked for.
# NOT committed: it imports `requests`, and `pyproject.toml` declares
# `dependencies = []`. Committing it would make that declaration false and give
# the package its first runtime dependency by accident rather than by decision.
# `accountant/tallyio/` is the supported path and uses urllib.
tally_client.py
