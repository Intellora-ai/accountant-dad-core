# Virtual environments
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Test and tool caches
.pytest_cache/
.testmondata*
.gremlins_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artefacts
dist/
build/

# Reports uploaded as CI artefacts, never committed
reports/

# macOS
.DS_Store

# Mutation and coverage reports
coverage/

# Pinned tools fetched by scripts/install-actionlint
.tools/

# TLS material. A private key committed once is in every clone and every fork
# forever, and six months later nobody can tell a test key from a real one by
# looking at it. Tests generate their certificate into `tmp_path` at run time
# (`tests/test_tls.py::certificate`), which is outside this tree already; these
# three lines are the second line of defence for the day somebody makes one in
# the working directory to try something.
*.pem
*.key
*.crt

# The durable database. This is a REAL CUSTOMER'S AUDIT TRAIL and their vendor
# and account history - the one file in this project that must never reach a
# commit. `ACCOUNTANT_DB` moves it; `data/app.db` is where it lands otherwise.
data/
*.db
*.sqlite3

# Agent worktrees. Nested git repositories, never part of a commit.
.claude/worktrees/

# The Tally audit trail. Same reasoning as `data/` above, and the same danger:
# every request and response XML under here carries a REAL COMPANY NAME, real
# supplier names and real amounts. Measured 2026-08-12: 21 files, all naming the
# live company. This repository is PUBLIC.
#
# The log is evidence, and it is meant to live on the machine that produced it.
# `ACCOUNTANT_LOG_DIR` and `ACCOUNTANT_XML_LOG_DIR` move it elsewhere.
logs/

# Superseded scratch client, kept locally because it works and it was asked for.
# NOT committed: it imports `requests`, and `pyproject.toml` declares
# `dependencies = []`. Committing it would make that declaration false and give
# the package its first runtime dependency by accident rather than by decision.
# `accountant/tallyio/` is the supported path and uses urllib.
tally_client.py

# Corpus-collection scratch, 2026-08-13. These fetch and repair the real-invoice
# corpus under data/, which is itself gitignored above - so the scripts have no
# committed subject and every run rewrites their inputs.
#
# THE REASON THEY ARE IGNORED RATHER THAN CLEANED AND COMMITTED: the `lint` and
# `format` gates run `ruff check .` and `ruff format --check .` over the WHOLE
# TREE, not over tracked files. Measured 2026-08-13: these paths carry 136 ruff
# errors and 15 unformatted files, while `git ls-files '*.py'` over the 230
# tracked files is clean. Committing them as they stand turns two required gates
# red; leaving them untracked-but-unignored means the next person to `git add -A`
# does it by accident.
#
# Promote any of them to a supported script by cleaning it and deleting its line
# here - deliberately, not by a stray add.
scripts_realdata/
scripts/collect_commons_documents.py
scripts/collect_real_invoices.py
scripts/migrate_gov_sidecars_to_shared_schema.py
scripts/rebuild_real_invoices_manifest.py
scripts/repair_real_invoices.py
scripts/verify_real_invoices.py

# Local disposable measurement scripts, ignored 2026-08-15 for the same reason
# as the six above: they are one-off probes, they are not product source, and
# left untracked-but-unignored the next `git add -A` sweeps them into a commit.
# MEASURED before ignoring: they contribute ~150 ruff errors and ~10 format
# failures, and both gates are `threshold = 0, required = true` in
# `ci/gates.toml` - so a fresh clone that included them would fail CI on work
# that has nothing to do with them.
#
# Their measurements are NOT lost. Every number they produced is recorded in
# `project.state.md` and in committed regression tests. Reproducible behaviour
# belongs in a test; a script that has to be re-run by hand is evidence that
# expires. `scripts/measure_field_slots.py` is deliberately NOT here - it is the
# approved measurement command and it is tracked.
scripts/find_indian_documents.py
scripts/measure_corpus.py
scripts/measure_indian_accuracy.py
scripts/measure_ocr_scanned.py
scripts/corpus/
