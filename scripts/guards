#!/usr/bin/env bash
# Every gate, on your laptop.
#
# THIS IS AN ACCELERATOR, NOT A GATE.
#
# Every check here is run again by CI, which blocks the merge. Skipping this
# script with `git commit --no-verify` therefore weakens nothing - it only costs
# you a slow round trip instead of a fast one. Nothing reaches main because this
# script was skipped. CI is the protection. This is the fast feedback loop.
#
#   ./scripts/guards --staged   changed files only, for the commit hook
#   ./scripts/guards            the fast gates
#   ./scripts/guards --full     everything, including mutation
#
# What it will NOT do: continue quietly when a guard is unavailable. A missing
# tool is a failure with an exact recovery command, never a warning.

set -uo pipefail
cd "$(dirname "$0")/.."

PY=".venv/bin"
ACTIONLINT=".tools/actionlint"
FULL=0
STAGED=0
KEEP_GOING=0
FAILED=()

for arg in "$@"; do
  case "$arg" in
    --staged)     STAGED=1 ;;
    --full)       FULL=1 ;;
    --keep-going) KEEP_GOING=1 ;;
    -h|--help)    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

if [ ! -x "$PY/python" ]; then
  echo "no virtualenv at $PY" >&2
  echo "fix it with:  ./scripts/setup" >&2
  exit 2
fi

# Python 3.12+ defaults coverage to the sysmon core, which does not support
# dynamic contexts. pytest-gremlins maps tests to lines with dynamic contexts,
# so on the default core that mapping is silently incomplete and the mutation
# score under-reports badly. Measured here 2026-08-07: 87.92% vs 94.34%.
export COVERAGE_CORE=pytrace

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
pass() { printf '  \033[32m✓\033[0m %-22s %s\n' "$1" "${2:-}"; }
fail() { printf '  \033[31m✗\033[0m %-22s %s\n' "$1" "${2:-}"; }

run() {
  local name="$1"; shift
  local out status
  out=$("$@" 2>&1); status=$?
  if [ $status -eq 0 ]; then
    pass "$name"
  else
    fail "$name"
    echo "$out" | sed 's/^/      /' | tail -30
    FAILED+=("$name")
    [ "$KEEP_GOING" -eq 1 ] || finish
  fi
}

finish() {
  echo
  if [ ${#FAILED[@]} -eq 0 ]; then
    if [ "$STAGED" -eq 1 ]; then
      bold "staged guards passed"
    else
      bold "all guards passed"
    fi
    exit 0
  fi
  bold "FAILED: ${FAILED[*]}"
  exit 1
}

# Any staged file under .github/ must trigger workflow validation, even when no
# Python changed. A workflow edit is exactly the change nobody should push
# unchecked.
workflows_touched() {
  [ -d .github ] || return 1
  if [ "$STAGED" -eq 1 ]; then
    git diff --cached --name-only | grep -q '^\.github/'
  else
    [ -d .github/workflows ]
  fi
}

staged_python() {
  git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true
}

# ---- staged mode: changed files only, aiming at a couple of seconds ---------

if [ "$STAGED" -eq 1 ]; then
  bold "staged guards"
  files=$(staged_python)
  if [ -n "$files" ]; then
    # shellcheck disable=SC2086
    run "lint"      "$PY/ruff" check $files
    # shellcheck disable=SC2086
    run "format"    "$PY/ruff" format --check $files
    # STAGED FILES ONLY, and the omission of `$files` here was a real defect.
    #
    # This block's own comment says "changed files only, aiming at a couple of
    # seconds", and .pre-commit-config.yaml says "staged mode is kept to a
    # couple of seconds on purpose. A hook slow enough to be worth bypassing is
    # a hook that gets bypassed." Bare `pyright` typechecks the WHOLE project,
    # so staged mode was neither.
    #
    # What that cost, twice on 2026-08-13: `prek` stashes all unstaged changes
    # to a patch file before running hooks and restores them afterwards. The
    # project-wide run exceeded the two-minute commit timeout, the run was
    # killed, the restore never happened, and the working tree LOST the changes.
    # It ate three tests out of tests/test_decision.py and 77 lines of
    # docs/OCR.md. Nothing failed and nothing warned - the suite went green
    # because the deleted tests were the ones that would have complained.
    #
    # A cross-file type error that only a whole-project run would catch is
    # still caught: `full` mode below runs it, and so does CI, which is what
    # actually blocks the merge. This hook says at the top of its own config
    # that it is AN ACCELERATOR, NOT A GATE.
    # shellcheck disable=SC2086
    run "typecheck" "$PY/pyright" $files
    run "tests"     "$PY/python" -m pytest --testmon -q
  else
    pass "lint" "no Python staged"
  fi
fi

# ---- full and default modes: cheapest first ---------------------------------

if [ "$STAGED" -eq 0 ]; then
  bold "fast guards"
  run "lockfile"        "$PY/uv" lock --check
  run "lint"            "$PY/ruff" check .
  run "format"          "$PY/ruff" format --check .
  run "typecheck"       "$PY/pyright"
  run "gate-contract"   "$PY/python" -m pytest tests/test_gate_contract.py -q
  run "no-stub-jobs"    "$PY/python" ci/check_stubs.py
  run "security-scan"   "$PY/bandit" -r accountant --severity-level low \
                            --confidence-level low -q
  run "tests"           "$PY/python" -m pytest -q
fi

# ---- workflow validation: FAILS when a tool is missing, never warns ---------

if workflows_touched; then
  run "workflow-security" "$PY/zizmor" --persona=pedantic .

  if [ ! -x "$ACTIONLINT" ]; then
    echo "  installing actionlint (pinned, checksum-verified)"
    if ! ./scripts/install-actionlint >/dev/null 2>&1; then
      fail "workflow-lint" "actionlint could not be installed"
      echo "      run this and read the error:  ./scripts/install-actionlint"
      echo "      or:                            brew install actionlint"
      FAILED+=("workflow-lint")
      finish
    fi
  fi
  run "workflow-lint" "$ACTIONLINT"
  run "no-stub-jobs"  "$PY/python" ci/check_stubs.py
fi

run "whitespace"      git diff --check

[ "$FULL" -eq 1 ] || finish

# ---- the slow ones ---------------------------------------------------------

echo
bold "full guards"
run "coverage"        "$PY/python" -c "
import subprocess, sys
subprocess.run(['$PY/coverage','run','-m','pytest','-q'],
               check=True, stdout=subprocess.DEVNULL)
sys.exit(subprocess.run(['$PY/coverage','report']).returncode)"
run "full-mutation"   "$PY/python" -m pytest --gremlins --gremlin-parallel \
                          --gremlin-targets=accountant --gremlin-report=json -q
run "mutation-accounting" "$PY/python" ci/check_mutation.py
run "package-build"   "$PY/python" -m build --outdir dist .
run "package-metadata" "$PY/twine" check --strict dist/accountant_dad-0.0.1.tar.gz \
                          dist/accountant_dad-0.0.1-py3-none-any.whl

finish
